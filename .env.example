# Server
PORT=3000
NODE_ENV=development

# Set to true only to expose the debug text-extraction endpoint (/api/v1/extract).
# Leave false/unset in any public deployment.
ENABLE_EXTRACTION_PREVIEW=false

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave unset for no cross-origin access (the bundled frontend is same-origin).
CORS_ORIGIN=

# Cloudflare R2 object storage (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Zilliz Cloud / Milvus vector database
MILVUS_ADDRESS=
MILVUS_TOKEN=

# Cloudflare Workers AI (embeddings + LLM classification)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: use surrounding-context embedding instead of isolated chunk embedding
USE_CONTEXT_EMBEDDING=false
