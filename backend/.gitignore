# Git ignore rules

# Dependencies
node_modules/


# Environment variables
.env
.env.local
.env.production


# Uploads
uploads/*
!uploads/.gitkeep


# OS files
Thumbs.db
desktop.ini
.DS_Store
.AppleDouble
.LSOverride


# IDE & Editor files
.vscode/
.idea/


# Logs
logs/
*.log
npm-debug.log*


# Test & coverage artifacts
coverage/
.nyc_output/
