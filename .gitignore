# ==========================================
# Root .gitignore — AI-Based Document Classifier
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
*.env
backend/.env
backend/.env.*

# Dependencies
node_modules/
backend/node_modules/

# Temporary Uploads (preserve .gitkeep if present)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test & Coverage artifacts
coverage/
.nyc_output/

# Editor & OS Metadata
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
